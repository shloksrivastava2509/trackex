# Copy to .env.local for `npm run dev`; set the same values in Vercel → Settings → Environment Variables.
# Generate secrets with:  openssl rand -base64 32

AUTH_SECRET=
AUTH_GOOGLE_ID=            # Google Cloud → APIs & Services → Credentials → OAuth client (Web)
AUTH_GOOGLE_SECRET=
DATABASE_URL=              # Neon → Connection string (pooled)
TOKEN_KEY=                 # 32 random bytes, base64 — encrypts Google refresh tokens at rest
CRON_SECRET=               # shared with the GitHub Actions sync workflow
ANTHROPIC_API_KEY=         # optional — without it Trackex uses keyword rules
CLAUDE_MODEL=claude-opus-5-5
