  "private": true,
  "description": "Sign in with Google once — Trackex reads your Gmail, tracks every job & internship application, and puts interviews, assessments and hackathon deadlines on your Google Calendar with reminders.",
  "license": "MIT",
  "author": "Shlok Srivastava",
  "homepage": "https://github.com/shloksrivastava2509/trackex#readme",
